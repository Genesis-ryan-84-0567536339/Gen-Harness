# Sao chép thành .env cho môi trường phát triển. Trình cài (genh) sinh các giá trị này khi cài thật.
GH_ENV=development
GH_PUBLIC_URL=https://localhost:8443
POSTGRES_USER=gh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gen_harness
# Khoá master KHÔNG nằm ở đây: `make secrets` sinh ./secrets/gh_master_key (Docker secret, không commit).
# Mã thiết lập một lần cho /setup (để trống thì api tự sinh và in ra log lúc khởi động)
GH_SETUP_TOKEN=
MINIO_ROOT_USER=gh
MINIO_ROOT_PASSWORD=change-me-too
